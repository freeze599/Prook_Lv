@using GreenYellowSite.Data
@{
    ViewData["Title"] = "Laistīšana, drošība un automātika";
    ViewData["MetaDescription"] = "PROOK — automātiskā laistīšana, videonovērošana, apsardze un gudrās mājas risinājumi. Konsultācija, uzstādīšana un atbalsts privātmājām un uzņēmumiem.";
}
<section class="p-shell p-hero">
    <div><p class="p-eyebrow">PROOK / Gudras sistēmas īpašumam</p><h1>Sakopts pagalms.<br />Drošāka māja.<br /><em>Mazāk rūpju.</em></h1><p class="p-lead">Laistīšanas, drošības un automātikas risinājumi privātmājām un uzņēmumiem. No konsultācijas līdz uzstādīšanai.</p><div class="p-actions"><a class="p-button" href="#pieteikties">Pārrunāsim jūsu ieceri <span aria-hidden="true">↗</span></a><a class="p-link" href="#risinajumi">Apskatīt risinājumus</a></div></div>
    <figure class="p-photo"><img src="~/images/prook-garden-960.webp" srcset="@Url.Content("~/images/prook-garden-640.webp") 640w, @Url.Content("~/images/prook-garden-960.webp") 960w, @Url.Content("~/images/prook-garden-1440.webp") 1440w" sizes="(max-width: 620px) calc(100vw - 36px), (max-width: 850px) 46vw, 564px" width="1440" height="960" alt="Automātiskā laistīšana zālienā" fetchpriority="high" /><figcaption><strong>Zaļš pagalms. Gudra laistīšana.</strong><span>Viens no PROOK risinājumiem jūsu īpašumam.</span></figcaption></figure>
</section>
<div class="p-band"><div class="p-shell p-band-inner"><span>@await Html.PartialAsync("_ProokIcon", "message") Konsultācija un risinājuma izvēle</span><span>@await Html.PartialAsync("_ProokIcon", "tools") Sistēmu uzstādīšana</span><span>@await Html.PartialAsync("_ProokIcon", "check") Atbalsts pēc uzstādīšanas</span></div></div>
<section id="risinajumi" class="p-shell p-section"><div class="p-heading"><h2>Kas nepieciešams<br />jūsu īpašumam?</h2><p>Izvēlieties virzienu.<br />Par tehniskajām detaļām parunāsim kopā.</p></div><div class="p-grid">
    @foreach (var group in ServiceGroups.All)
    {
        <article class="p-card">
            @await Html.PartialAsync("_ProokIcon", group.Icon)
            <h3>@group.Title</h3><p>@group.Description</p>
            <ul>
                @foreach (var service in ServiceCatalog.All.Where(s => ServiceGroups.Key(s.Slug) == group.Key))
                {
                    <li><a asp-controller="Site" asp-action="ServiceDetail" asp-route-slug="@service.Slug">@service.Title <span aria-hidden="true">↗</span></a></li>
                }
            </ul>
            <a class="p-link" asp-controller="Site" asp-action="Services" asp-fragment="@group.Key">Vairāk par risinājumiem <span aria-hidden="true">→</span></a>
        </article>
    }
</div></section>
<div class="p-process"><div class="p-shell p-process-inner"><b>No ieceres līdz risinājumam</b><span><span>01 /</span>Pārrunājam vajadzības</span><span><span>02 /</span>Vienojamies par piedāvājumu</span><span><span>03 /</span>Uzstādām sistēmu</span></div></div>
<section class="p-contact-section" id="pieteikties"><div class="p-shell p-contact-grid"><div class="p-contact-copy"><p class="p-eyebrow">Sāksim ar sarunu</p><h2>Pastāstiet,<br />ko vēlaties uzlabot.</h2><p>Nav jāzina iekārtu modeļi vai tehniskie termini. Aprakstiet savu ieceri — palīdzēsim saprast nākamo soli.</p><p class="p-contact-phone"><a href="tel:+37120292787">+371 20292787</a></p><p><a href="mailto:info@prook.lv">info@prook.lv</a></p><p><a class="p-link" href="https://wa.me/37120292787" target="_blank" rel="noopener noreferrer">Ērtāk WhatsApp? Rakstiet mums ↗</a></p></div><partial name="_ContactForm" model="new GreenYellowSite.Models.ContactFormModel()" /></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
