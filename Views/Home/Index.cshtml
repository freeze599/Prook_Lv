@using GreenYellowSite.Data
@{
    ViewData["Title"] = "Sākums";
    ViewData["MetaDescription"] = "PROOK piedāvā videonovērošanu, apsardzes sistēmas, elektrības darbus, saules paneļus un gudros risinājumus mājām un uzņēmumiem Latvijā.";
    var services = ServiceCatalog.All;
}

<section class="relative overflow-hidden text-white">

    <div class="absolute inset-0">
        <img src="/images/fons1.jpg" alt="Hero background" width="1600" height="1067"
             class="h-full w-full object-cover object-right">
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/85 via-slate-950/55 to-slate-950/35"></div>

    <div class="rounded-[2rem] border border-white/15 bg-slate-950/50 p-8 shadow-2xl md:p-10">

        <div class="relative mx-auto grid max-w-7xl gap-12 px-6 py-28 md:grid-cols-2 md:items-center">

            <!-- Kreisā puse -->
            <div>
                <h1 class="mt-4 text-5xl font-bold leading-tight md:text-6xl">
                    Gudras drošības sistēmas jūsu īpašumam
                </h1>

                <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
                    Laistīšanas sistēmu uzstādīšana. Videonovērošana, piekļuves kontrole,
                    gudrās mājas un datu tīklu risinājumi privātmājām un uzņēmumiem.
                </p>

                <div class="mt-8 flex flex-wrap gap-4">
                    <a asp-controller="Site" asp-action="Services"
                           class="rounded-lg border border-white/30 px-6 py-3 font-semibold transition hover:bg-white/10">
                        Skatīt pakalpojumus
                    </a>
                </div>
            </div>

            <!-- Labā puse -->
            <div class="rounded-[2rem] border border-white/15 bg-slate-950/45 p-8 shadow-2xl md:p-10">
                <div class="grid gap-5">

                    <div class="flex items-start gap-4">
                        <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime-400 text-slate-950 font-bold shadow-lg">
                            ✓
                        </div>
                        <div>
                            <p class="font-semibold text-white text-lg">Zālāju laistīšanas sistēmas</p>
                            <p class="mt-1 text-sm text-slate-200">Automātiska un efektīva teritorijas laistīšana.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4">
                        <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime-400 text-slate-950 font-bold shadow-lg">
                            ✓
                        </div>
                        <div>
                            <p class="font-semibold text-white text-lg">Drošība un kontrole</p>
                            <p class="mt-1 text-sm text-slate-200">Videonovērošana, signalizācija un piekļuves kontrole.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4">
                        <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime-400 text-slate-950 font-bold shadow-lg">
                            ✓
                        </div>
                        <div>
                            <p class="font-semibold text-white text-lg">Automatizācija un ērtība</p>
                            <p class="mt-1 text-sm text-slate-200">Gudrās mājas risinājumi ikdienas komfortam.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4">
                        <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime-400 text-slate-950 font-bold shadow-lg">
                            ✓
                        </div>
                        <div>
                            <p class="font-semibold text-white text-lg">Stabils tīkls un infrastruktūra</p>
                            <p class="mt-1 text-sm text-slate-200">Datu tīkli, Wi-Fi un tehnoloģiju pamats jūsu īpašumam.</p>
                        </div>
                    </div>

                </div>
            </div>

        </div>
</section>
<section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="mb-12">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-600">Pakalpojumi</p>
            <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">
                Mūsu piedāvātie risinājumi
            </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var service in services)
            {
                <a asp-controller="Site"
                       asp-action="ServiceDetail"
                       asp-route-slug="@service.Slug"
                       class="group flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:border-lime-300 hover:shadow-2xl">

                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-lime-50 text-3xl shadow-sm transition group-hover:scale-110">
                        @service.Icon
                    </div>

                    <h3 class="mt-6 text-xl font-bold text-slate-900 transition group-hover:text-lime-600">
                        @service.Title
                    </h3>

                    <p class="mt-4 flex-grow leading-7 text-slate-600">
                        @service.ShortDescription
                    </p>

                    <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-lime-600">
                        <span>Uzzināt vairāk</span>
                        <span class="transition group-hover:translate-x-1">→</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="bg-slate-50 py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 md:grid-cols-2 md:items-center">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-600">Par uzņēmumu</p>
            <h2 class="mt-4 text-3xl font-bold text-slate-900 md:text-4xl">
                Uzticami tehnoloģiju risinājumi jūsu videi
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-600">
                Mūsu mērķis ir palīdzēt klientiem ieviest modernus drošības un automatizācijas risinājumus. Kuri uzlabos ikdienas komfortu un drošību.
            </p>
            <p class="mt-4 leading-7 text-slate-600">
                Mēs strādājam ar individuālu pieeju katram klientam. Izvērtējot konkrētā objekta vajadzības un piedāvājot optimālo tehnisko risinājumu.
            </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Pieredze</p>
                <p class="mt-2 text-2xl font-bold text-slate-900">Drošība un automatizācija</p>
            </div>
            <div class="rounded-2xl bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Pieeja</p>
                <p class="mt-2 text-2xl font-bold text-slate-900">Ilgtermiņa risinājumi</p>
            </div>
            <div class="rounded-2xl bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Darbs</p>
                <p class="mt-2 text-2xl font-bold text-slate-900">Kvalitāte un inovācija</p>
            </div>
            <div class="rounded-2xl bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Atbalsts</p>
                <p class="mt-2 text-2xl font-bold text-slate-900">Tehniskais atbalsts</p>
            </div>
        </div>
    </div>
</section>

<section class="bg-slate-950 py-20 text-white">
    <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-400">Kā mēs strādājam</p>
            <h2 class="mt-4 text-3xl font-bold md:text-4xl">
                Skaidrs process no idejas līdz uzstādīšanai
            </h2>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-4">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                <div class="text-sm font-semibold text-lime-400">1. solis</div>
                <h3 class="mt-4 text-xl font-bold">Konsultācija</h3>
                <p class="mt-3 leading-7 text-slate-300">
                    Noskaidrojam jūsu vajadzības un objekta specifiku.
                </p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                <div class="text-sm font-semibold text-lime-400">2. solis</div>
                <h3 class="mt-4 text-xl font-bold">Risinājuma izstrāde</h3>
                <p class="mt-3 leading-7 text-slate-300">
                    Izvēlamies piemērotāko tehnisko risinājumu.
                </p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                <div class="text-sm font-semibold text-lime-400">3. solis</div>
                <h3 class="mt-4 text-xl font-bold">Uzstādīšana</h3>
                <p class="mt-3 leading-7 text-slate-300">
                    Veicam profesionālu sistēmas uzstādīšanu un konfigurēšanu.
                </p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                <div class="text-sm font-semibold text-lime-400">4. solis</div>
                <h3 class="mt-4 text-xl font-bold">Atbalsts</h3>
                <p class="mt-3 leading-7 text-slate-300">
                    Sniedzam konsultācijas un palīdzam arī pēc projekta pabeigšanas.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-600">Video un projekti</p>
            <h2 class="mt-4 text-3xl font-bold text-slate-900 md:text-4xl">
                Mūsu realizētie projekti
            </h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">
                Šeit varat iepazīties ar dažiem no mūsu realizētajiem projektiem.
            </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
            <div class="flex min-h-[280px] items-center justify-center rounded-3xl bg-slate-200 text-center text-slate-500">
                Video vieta
            </div>

            <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8">
                <h3 class="text-2xl font-bold text-slate-900">Par projektu demonstrācijām</h3>
                <p class="mt-4 leading-8 text-slate-600">
                    Šeit drīz būs apskatāmi video.
                </p>
                <p class="mt-4 leading-8 text-slate-600">
                    Šeit drīz būs redzami un aprakstīti realizētie projekti.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-600">Galerija</p>
            <h2 class="mt-4 text-3xl font-bold text-slate-900 md:text-4xl">
                Pirms un pēc
            </h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">
                Šeit drīz būs apskatāmi darbi pirms un pēc realizēšanas.
            </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-72 items-center justify-center rounded-2xl bg-slate-200 text-slate-500">
                    Pirms
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">Objekts pirms uzlabošanas</h3>
                <p class="mt-3 leading-7 text-slate-600">
                    @* Vietturis attēlam un īsam aprakstam par sākotnējo situāciju. *@
                </p>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-72 items-center justify-center rounded-2xl bg-slate-200 text-slate-500">
                    Pēc
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">Rezultāts pēc uzstādīšanas</h3>
                <p class="mt-3 leading-7 text-slate-600">
                    @* Vietturis attēlam un īsam aprakstam par paveikto risinājumu. *@
                </p>
            </div>
        </div>
    </div>
</section>

<section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="rounded-[2rem] bg-lime-500 px-8 py-14 text-white md:px-14">
            <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
                <div class="max-w-2xl">
                    <h2 class="text-3xl font-bold md:text-4xl">
                        Vajadzīgs risinājums jūsu objektam?
                    </h2>
                    <p class="mt-4 text-lg text-lime-50">
                        Sazinieties ar mums, un palīdzēsim izvēlēties piemērotāko variantu.
                    </p>
                </div>

                <div>
                    <a asp-controller="Site" asp-action="Contact"
                           class="inline-block rounded-lg bg-white px-6 py-3 font-semibold text-lime-700 transition hover:bg-slate-100">
                        Pieteikties konsultācijai
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>