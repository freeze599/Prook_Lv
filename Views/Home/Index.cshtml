@using GreenYellowSite.Data
@{
    ViewData["Title"] = "Sākums";
    ViewData["MetaDescription"] = "PROOK piedāvā videonovērošanu, apsardzes sistēmas, elektrības darbus, saules paneļus un gudros risinājumus mājām un uzņēmumiem Latvijā.";
    var services = ServiceCatalog.All;
}

<section class="relative overflow-hidden text-white">

    <!-- Background -->
    <div class="absolute inset-0">
        <img src="/images/hero.jpg"
             alt="Background"
             class="h-full w-full object-cover object-center" />
    </div>

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-slate-950/75"></div>

    <!-- Content -->
    <div class="relative mx-auto grid max-w-7xl gap-16 px-6 py-24 md:grid-cols-2 md:items-center">

        <!-- Kreisā puse -->
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-lime-400">
                GUDRAS SISTĒMAS IKVIENAM
            </p>

            <h1 class="mt-6 text-5xl font-bold leading-tight md:text-6xl">
                Drošība un automatizācija mūsdienīgai videi
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
                Mēs piedāvājam laistīšanas, videonovērošanas, apsardzes un automatizācijas sistēmu uzstādīšanu privātmājām un uzņēmumiem.
            </p>
        </div>

        <!-- Labā puse -->
        <div class="relative hidden md:block">
            <div class="absolute -inset-4 rounded-[2rem] bg-lime-500/10 blur-3xl"></div>

            <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 shadow-2xl backdrop-blur">
                <img src="/images/fons1.jpg"
                     alt="Laistīšanas sistēma"
                     class="h-[420px] w-full object-cover" />
            </div>
        </div>

    </div>
</section>
<section class="bg-slate-50 py-24">
    <div class="mx-auto max-w-7xl px-6">
        <div class="mb-12">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-600">Pakalpojumi</p>
            <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">
                Mūsu piedāvātie risinājumi
            </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var service in services)
            {
                <a asp-controller="Site"
                       asp-action="ServiceDetail"
                       asp-route-slug="@service.Slug"
                       class="group flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:border-lime-300 hover:shadow-2xl">

                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-lime-50 text-3xl shadow-sm transition group-hover:scale-110">
                        @service.Icon
                    </div>

                    <h3 class="mt-6 text-xl font-bold text-slate-900 transition group-hover:text-lime-600">
                        @service.Title
                    </h3>

                    <p class="mt-4 flex-grow leading-7 text-slate-600">
                        @service.ShortDescription
                    </p>

                    <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-lime-600">
                        <span>Uzzināt vairāk</span>
                        <span class="transition group-hover:translate-x-1">→</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="border-t border-lime-100 bg-lime-50/30 pt-16 pb-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="mx-auto mb-12 max-w-4xl text-center">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-600">
                Kāpēc izvēlēties PROOK
            </p>

            <h2 class="mt-4 text-3xl font-bold leading-tight text-slate-950 md:text-4xl">
                Uzticami risinājumi no idejas līdz uzstādīšanai
            </h2>

            <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-600">
                Nodrošinām pārdomātus tehniskos risinājumus, sākot no konsultācijas līdz kvalitatīvai uzstādīšanai un atbalstam.
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            <div class="flex items-start gap-5 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                <div class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lime-100 text-xl">
                    🛡️
                </div>
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-lime-600">Pieredze</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-950">Drošības risinājumi</h3>
                    <p class="mt-3 leading-7 text-slate-600">
                        Modernas drošības sistēmas jūsu īpašumam un biznesam.
                    </p>
                </div>
            </div>

            <div class="flex items-start gap-5 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                <div class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lime-100 text-xl">
                    ⚙️
                </div>
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-lime-600">Pieeja</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-950">Ilgtermiņa risinājumi</h3>
                    <p class="mt-3 leading-7 text-slate-600">
                        Uzticami un ilgtspējīgi risinājumi jūsu videi.
                    </p>
                </div>
            </div>

            <div class="flex items-start gap-5 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                <div class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lime-100 text-xl">
                    💡
                </div>
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-lime-600">Darbs</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-950">Kvalitāte un inovācija</h3>
                    <p class="mt-3 leading-7 text-slate-600">
                        Izmantojam mūsdienīgas tehnoloģijas kvalitatīvam rezultātam.
                    </p>
                </div>
            </div>

            <div class="flex items-start gap-5 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                <div class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lime-100 text-xl">
                    🤝
                </div>  
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-lime-600">Atbalsts</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-950">Tehniskais atbalsts</h3>
                    <p class="mt-3 leading-7 text-slate-600">
                        Operatīvs un profesionāls atbalsts arī pēc uzstādīšanas.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

<section class="bg-slate-950 py-24 text-white">
    <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-400">
                Par uzņēmumu
            </p>

            <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">
                Uzticami tehnoloģiju risinājumi jūsu videi
            </h2>

            <p class="mt-6 text-lg leading-8 text-slate-300">
                Mūsu mērķis ir palīdzēt klientiem ieviest modernus drošības un automatizācijas risinājumus, kuri uzlabo ikdienas komfortu un drošību.
            </p>

            <p class="mt-4 text-lg leading-8 text-slate-300">
                Mēs strādājam ar individuālu pieeju katram klientam, izvērtējot konkrētā objekta vajadzības un piedāvājot optimālo tehnisko risinājumu.
            </p>
        </div>
    </div>
</section>

