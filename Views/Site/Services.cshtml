@model IEnumerable<GreenYellowSite.Models.Service>
@using GreenYellowSite.Data
@{
    ViewData["Title"] = "Risinājumi jūsu īpašumam";
    ViewData["MetaDescription"] = "PROOK risinājumi pagalmam, drošībai un ikdienas ērtībai — laistīšana, videonovērošana, apsardze, vārtu automātika un datu tīkli.";
}
<section class="p-page-head"><div class="p-shell"><p class="p-eyebrow">PROOK / Risinājumi</p><h1>Gudri risinājumi.<br />Jūsu ikdienai.</h1><p>No automātiskas laistīšanas līdz drošības sistēmām. Izvēlieties pakalpojumu un uzziniet vairāk.</p></div></section>
<section class="p-shell p-section">
@foreach (var group in ServiceGroups.All)
{
    var services = Model.Where(s => ServiceGroups.Key(s.Slug) == group.Key).ToList();
    if (services.Count == 0) { continue; }
    <section class="p-service-group" id="@group.Key"><div class="p-heading"><h2>@group.Title</h2><p>@group.Description</p></div><div class="p-grid p-service-grid">
        @foreach (var service in services)
        {
            <article class="p-card">@await Html.PartialAsync("_ProokIcon", group.Icon)<h3>@service.Title</h3><p>@service.ShortDescription</p><a class="p-link" asp-controller="Site" asp-action="ServiceDetail" asp-route-slug="@service.Slug">Uzzināt vairāk <span aria-hidden="true">↗</span></a></article>
        }
    </div></section>
}
</section>
