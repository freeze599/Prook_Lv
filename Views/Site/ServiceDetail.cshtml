@model GreenYellowSite.Models.Service

@{
    ViewData["Title"] = Model.Title;
}

<section class="bg-slate-950 py-16 text-white">
    <div class="mx-auto max-w-5xl px-6">
        <div class="text-5xl">@Model.Icon</div>
        <h1 class="mt-4 text-4xl font-bold">@Model.Title</h1>
        <p class="mt-4 text-lg text-slate-300">@Model.ShortDescription</p>
    </div>
</section>

<section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-6">
        <div class="rounded-3xl border border-slate-200 bg-white p-10 shadow-sm">
            <p class="text-lg leading-8 text-slate-700">
                @Model.Description
            </p>

            <div class="mt-10">
                <a asp-controller="Site" asp-action="Contact"
                   class="rounded-lg bg-lime-500 px-6 py-3 font-semibold text-white transition hover:bg-lime-600">
                    Sazināties par šo pakalpojumu
                </a>
            </div>
        </div>
    </div>
</section>