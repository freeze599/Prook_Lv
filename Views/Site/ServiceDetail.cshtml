<section class="p-page-head"><div class="p-shell"><nav class="p-breadcrumb" aria-label="Atrašanās vieta"><a asp-controller="Home" asp-action="Index">Sākums</a><span aria-hidden="true">/</span><a asp-controller="Site" asp-action="Services">Risinājumi</a></nav><h1>@Model.Title</h1><p>@Model.ShortDescription</p></div></section>
<section class="p-shell p-section p-detail-layout">
    <div class="p-detail-copy"><p>@Model.Description</p><div class="p-detail-columns"><section><h2>Kam tas paredzēts?</h2><p>@content.kamParedzets</p></section><section><h2>Ko ietver pakalpojums?</h2><p>@content.koIetver</p></section></div><section class="p-benefits"><h2>Galvenie ieguvumi</h2><ul>@foreach (var item in content.ieguvumi) { <li>@item</li> }</ul></section></div>
    <aside class="p-aside"><h2>Pārrunāsim<br />jūsu ieceri.</h2><p>Pastāstiet par savu objektu un vajadzībām. Palīdzēsim izvēlēties risinājumu.</p><a class="p-button" asp-controller="Site" asp-action="Contact" asp-route-service="@Model.Slug">Pieteikt konsultāciju ↗</a><a href="tel:+37120292787">+371 20292787</a></aside>
</section>
