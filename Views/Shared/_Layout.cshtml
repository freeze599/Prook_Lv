@{
    var pageTitle = ViewData["Title"] as string ?? "PROOK";
    var description = ViewData["MetaDescription"] as string ?? "PROOK — laistīšanas, drošības un automātikas risinājumi privātmājām un uzņēmumiem.";
    var canonical = "https://prook.lv" + Context.Request.PathBase.ToString() + Context.Request.Path.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="lv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle — PROOK</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="lv_LV" />
    <meta property="og:site_name" content="PROOK" />
    <meta property="og:title" content="@pageTitle — PROOK" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="https://prook.lv/images/prook-social.jpg" />
    <meta property="og:image:alt" content="PROOK — automātiskā laistīšana" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prook.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-52KCN27014"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-52KCN27014');
    </script>
</head>
<body class="prook">
    <a class="p-skip" href="#main-content">Pāriet uz saturu</a>
    <header class="p-header">
        <div class="p-shell p-header-inner">
            <a class="p-logo" asp-controller="Home" asp-action="Index" aria-label="PROOK — sākums"><img src="~/images/prook-logo.png" asp-append-version="true" width="522" height="178" alt="PROOK — gudras sistēmas" /></a>
            <button class="p-menu" type="button" hidden aria-expanded="false" aria-controls="prook-nav">Izvēlne ☰</button>
            <nav class="p-nav" id="prook-nav" aria-label="Galvenā navigācija">
                <a asp-controller="Home" asp-action="Index" aria-current="@(action == "Index" ? "page" : null)">Sākums</a>
                <a asp-controller="Site" asp-action="Services" aria-current="@(action is "Services" or "ServiceDetail" ? "page" : null)">Risinājumi</a>
                <a asp-controller="Site" asp-action="Contact" aria-current="@(action == "Contact" ? "page" : null)">Sazināties ↗</a>
            </nav>
            <a class="p-phone" href="tel:+37120292787">+371 20292787</a>
        </div>
    </header>
    @* Run navigation before main is parsed to prevent a mobile menu layout shift. *@
    <script src="~/js/prook.js" asp-append-version="true"></script>
    <main id="main-content" tabindex="-1">@RenderBody()</main>
    <footer class="p-footer">
        <div class="p-shell">
            <div class="p-footer-top">
                <div><div class="p-footer-brand">PROOK</div><p>Laistīšana, drošība un automātika.<br />Gudras sistēmas jūsu īpašumam.</p></div>
                <div class="p-footer-links">
                    <a asp-controller="Site" asp-action="Services">Pakalpojumi</a>
                    <a href="mailto:info@prook.lv">info@prook.lv</a>
                    <a href="https://wa.me/37120292787" target="_blank" rel="noopener noreferrer">Rakstīt WhatsApp ↗</a>
                </div>
            </div>
            <div class="p-footer-bottom"><span>© @DateTime.Now.Year PROOK. Visas tiesības aizsargātas.</span><span>Mājaslapas izstrāde: <a href="mailto:arnolds.scuckis@inbox.lv">Arnolds Ščuckis</a></span></div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
