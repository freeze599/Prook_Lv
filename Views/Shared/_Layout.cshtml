<!DOCTYPE html>
<html lang="lv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROOK</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "PROOK nodrošina drošības sistēmas, videonovērošanu, elektrības darbus, piekļuves kontroli un citus viedos risinājumus mājām un uzņēmumiem.")" />
    <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/android-chrome-512x512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicon-180x180.png">
    <link rel="icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-white text-slate-800">

    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">

        <div class="mx-auto max-w-7xl px-4 sm:px-6">

            <div class="flex items-center justify-between py-3">

                <a asp-controller="Home" asp-action="Index" class="flex items-center shrink-0">
                    <img src="~/images/logo_2.png" alt="PROOK logo" width="3430" height="1168"
                         style="height:60px; width:auto;" />
                </a>  

                <!-- Navigācija -->
                <nav class="hidden md:flex items-center gap-8 text-lg font-medium text-slate-700 hover:text-lime-500">
                    <a asp-controller="Home" asp-action="Index"
                           class="relative hover:text-black transition">
                        Sākums
                    </a>

                    <a asp-controller="Site" asp-action="Services"
                           class="relative hover:text-black transition">
                        Pakalpojumi
                    </a>

                    <a asp-controller="Site" asp-action="Contact"
                           class="relative hover:text-black transition">
                        Kontakti 
                    </a>
                </nav>

                <!-- Labā puse -->
                <div class="flex items-center gap-4">

                    <div class="flex items-center">
                        <a href="tel:+37120292787"
                           class="block text-sm sm:text-base md:text-lg font-semibold tracking-wide text-slate-700 hover:text-lime-600 transition">
                            +371 20292787
                        </a>
                    </div>

                </div>

            </div>  
        </div>
    </header>
   

    <main>
        @RenderBody()
    </main>

    <footer class="mt-20 bg-slate-900 text-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-6 py-12 md:grid-cols-3">
            <div>
                <h3 class="text-xl font-semibold">PROOK</h3>
                <p class="mt-3 text-sm leading-6 text-slate-400">
                    Drošības, automātikas un gudro sistēmu risinājumi mājai un uzņēmumam.
                </p>
            </div>

            <div>
                <h3 class="text-xl font-semibold">Seko mums</h3>
                <div class="mt-3 flex gap-3 text-slate-400">
                    <span>Facebook</span>
                    <span>Instagram</span>
                   
                </div>
            </div>

            <div>
                <h3 class="text-xl font-semibold">Sazinies ar mums</h3>
                <p class="mt-3 text-slate-400">Tel.: +371 20292787</p>
                <p class="text-slate-400">E-pasts: info@prook.lv</p>
            </div>
        </div>

        <div class="border-t border-slate-800 px-6 py-4 text-center text-sm text-slate-500">
            © @DateTime.Now.Year PROOK. Visas tiesības aizsargātas. Mājas lapu izveidoja Arnolds Ščuckis - arnolds.scuckis@inbox.lv.
        </div>
    </footer>
    <div class="fixed bottom-6 right-6 z-[9999]"> 
        <a href="https://wa.me/37120292787"
           target="_blank"
           rel="noopener noreferrer"
           class="flex items-center gap-2 rounded-full bg-lime-500 px-5 py-3 text-sm font-semibold text-white shadow-2xl transition hover:scale-105 hover:bg-lime-600"
           aria-label="Sazināties WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="currentColor"
                 class="h-5 w-5">
                <path d="M12 2C6.48 2 2 6.26 2 11.53c0 2.1.73 4.04 1.96 5.61L2 22l5.06-1.89c1.48.78 3.16 1.21 4.94 1.21 5.52 0 10-4.26 10-9.53S17.52 2 12 2zm.01 17.06c-1.54 0-3.02-.39-4.32-1.13l-.31-.18-3 .99.99-2.92-.2-.3c-.79-1.24-1.21-2.66-1.21-4.1 0-4.28 3.63-7.77 8.04-7.77s8.04 3.49 8.04 7.77-3.63 7.77-8.03 7.77zm4.41-5.82c-.24-.12-1.41-.69-1.63-.77-.22-.08-.38-.12-.54.12s-.62.77-.76.93c-.14.16-.28.18-.52.06-.24-.12-1.01-.36-1.92-1.15-.71-.62-1.19-1.38-1.33-1.62-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.29-.74-1.76-.2-.48-.41-.41-.54-.41-.14 0-.3-.02-.46-.02s-.42.06-.64.3c-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.54 4.1 3.56.57.24 1.01.38 1.36.48.57.18 1.09.16 1.5.1.46-.07 1.41-.57 1.61-1.12.2-.55.2-1.02.14-1.12-.06-.1-.22-.16-.46-.28z" />
            </svg>
            <span>WhatsApp</span>
        </a>
    </div>
    <script>

        const btn = document.getElementById("menuBtn");
        const menu = document.getElementById("mobileMenu");

        btn.addEventListener("click", () => {
            menu.classList.toggle("hidden");
        });

    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>